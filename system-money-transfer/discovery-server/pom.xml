<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hdl.mt</groupId>
        <artifactId>system-money-transfer-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>discovery-server</artifactId>
    <name>discovery-server</name>
    <description>Eureka server — "danh bạ" để các service đăng ký và tra nhau theo tên.</description>

    <dependencies>
        <!--
          Eureka server. Version do spring-cloud BOM (2025.0.3) quản.
          Eureka VẪN được maintain (starter còn release 2025). Ta học nó để hiểu CƠ CHẾ
          discovery (đăng ký/heartbeat/tra cứu); trong K8s về sau việc này do platform lo.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
